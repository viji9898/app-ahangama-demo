# Site Configuration
VITE_SITE_URL=http://localhost:8888

# Environment (development | production)
NODE_ENV=development

# Map API Keys (optional - get from respective services)
VITE_MAPBOX_TOKEN=your_mapbox_token_here
VITE_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# Stripe Configuration (get from Stripe Dashboard)
# Development/Test Key
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key_here
# Production/Live Key (only needed in production)
STRIPE_SECRET_KEY_LIVE=sk_live_your_stripe_live_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here

# SendGrid Configuration
SENDGRID_API_KEY=SG.your_sendgrid_api_key_here

# PassKit SmartPass credentials
PASSKIT_DISTRIBUTION_URL=distribution_url_here
PASSKIT_SMARTPASS_KEY=project_key_here
PASSKIT_SMARTPASS_SECRET=secret_key_here

# Google Places API key is configured outside source control.
# Set GOOGLE_PLACES_API_KEY in .env locally and in Netlify environment variables.

# Google Analytics 4 Data API (venue statistics pages, server-side only)
# Numeric property id — NOT the G- measurement id.
GA4_PROPERTY_ID=
# Service account with Viewer access to the GA4 property.
# Provide either the full JSON on one line…
GA4_SERVICE_ACCOUNT_JSON=
# …or the individual fields.
GA4_SERVICE_ACCOUNT_EMAIL=
GA4_SERVICE_ACCOUNT_PRIVATE_KEY=

# Meta / Instagram Graph API (venue statistics, server-side only)
# System User token with instagram_basic, pages_show_list,
# pages_read_engagement and instagram_manage_insights.
META_SYSTEM_USER_ACCESS_TOKEN=
# Facebook Page connected to Ahangama's Instagram Business account.
META_PAGE_ID=
# Instagram Business account id — not the @username.
META_INSTAGRAM_ACCOUNT_ID=
# Graph API version, for example v26.0.
META_GRAPH_API_VERSION=

# Admin password for the guide dashboard and venue statistics pages.
GUIDE_ADMIN_PASSWORD=

# Optional local-preview database for venue statistics content only.
# Production leaves this empty and uses DATABASE_URL.
VENUE_STATS_DATABASE_URL=

# Isolated PostgreSQL database for the Instagram sync integration tests.
# Tests are skipped unless ALLOW_INSTAGRAM_DB_TESTS=1 is also set. The host must
# be loopback unless listed in INSTAGRAM_TEST_DATABASE_HOSTS, and the database
# name must contain a test/staging/ci/dev segment. Never point this at production.
INSTAGRAM_TEST_DATABASE_URL=
ALLOW_INSTAGRAM_DB_TESTS=
# Optional comma-separated extra hosts for a disposable CI database. Loopback
# hosts are always allowed. Do not list a production database host here.
INSTAGRAM_TEST_DATABASE_HOSTS=

# TEMPORARY preview switch: set to 1 to browse /stats without a password.
# Ignored outside local development (production, deploy previews and
# branch deploys). Remove or unset to restore the normal password gate.
VENUE_STATS_AUTH_DISABLED=
